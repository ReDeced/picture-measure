root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
# rustfmt всё равно форматирует исходники; эти настройки — для diff и редакторов.
max_line_length = 100

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
# В Markdown два пробела в конце строки означают перенос строки,
# поэтому trailing whitespace там значим.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{desktop,sh}]
indent_style = space
indent_size = 4

[*.svg]
indent_size = 2